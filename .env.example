# Frontend Environment Variables Example
# Copy this file to .env.local for development

# LIFF Configuration
NEXT_PUBLIC_LIFF_ID=your_liff_id_here

# API Configuration
NEXT_PUBLIC_API_URL=https://ss-backend.unayung.cc/api
NEXT_PUBLIC_BACKEND_URL=https://ss-backend.unayung.cc

# Socket Configuration (optional)
NEXT_PUBLIC_SOCKET_URL_FALLBACK=https://ss-backend.unayung.cc

# Development Configuration (optional)
CORS_ALLOWED_ORIGINS=https://ss.unayung.cc,http://localhost:3000,http://localhost:4000
ALLOWED_DEV_ORIGINS=localhost,ss.unayung.cc

# LINE OAuth (optional - for custom LINE integration)
LINE_OAUTH_URL=https://access.line.me/oauth2/v2.1/authorize