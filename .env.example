# Frontend Environment Variables Example
# Copy this file to .env for development

# Mock API Configuration
# Set to 'true' for frontend-only development (no backend needed)
# Set to 'false' to connect to real backend
NEXT_PUBLIC_USE_MOCK_API=false

# Mock API Settings (only used when NEXT_PUBLIC_USE_MOCK_API=true)
NEXT_PUBLIC_MOCK_DELAY_MIN=200
NEXT_PUBLIC_MOCK_DELAY_MAX=800
NEXT_PUBLIC_MOCK_ERRORS=false
NEXT_PUBLIC_MOCK_LOGS=true
NEXT_PUBLIC_PERSIST_MOCK_STATE=true

# Backend Configuration (only used when NEXT_PUBLIC_USE_MOCK_API=false)
# Should be https url
NEXT_PUBLIC_BACKEND_URL=https://your-backend-domain.com
NEXT_PUBLIC_API_URL=https://your-backend-domain.com/api

# LINE Login Configuration (only used when NEXT_PUBLIC_USE_MOCK_API=false)
NEXT_PUBLIC_LIFF_ID=your_liff_id_here
