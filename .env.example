# Frontend Environment Variables Example
# Copy this file to .env.local for your development setup

# Mock API Configuration
# Set to 'true' to use mock API for frontend-only development (recommended for UI work)
# Set to 'false' to connect to real backend
NEXT_PUBLIC_USE_MOCK_API=false

# Mock API Settings (only used when NEXT_PUBLIC_USE_MOCK_API=true)
NEXT_PUBLIC_MOCK_DELAY_MIN=200
NEXT_PUBLIC_MOCK_DELAY_MAX=800
NEXT_PUBLIC_MOCK_ERRORS=false
NEXT_PUBLIC_MOCK_LOGS=true
NEXT_PUBLIC_PERSIST_MOCK_STATE=true

# Backend Configuration (only used when NEXT_PUBLIC_USE_MOCK_API=false)
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# LINE Login Configuration (only used when NEXT_PUBLIC_USE_MOCK_API=false)
NEXT_PUBLIC_LIFF_ID=your-liff-id-here
NEXT_PUBLIC_LINE_LOGIN_CHANNEL_ID=your-line-channel-id-here

# Production URLs (for reference)
# NEXT_PUBLIC_API_URL=https://ss-backend.unayung.cc/api
# NEXT_PUBLIC_BACKEND_URL=https://ss-backend.unayung.cc
