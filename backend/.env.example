# Backend Environment Variables Example
# Copy this file to .env for development

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=https://ss.unayung.cc

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=saiens_credit_dev

# Authentication
JWT_SECRET=your_super_secure_jwt_secret_change_in_production

# LINE API Configuration
LIFF_CHANNEL_ID=your_liff_channel_id
LIFF_CHANNEL_SECRET=your_liff_channel_secret
LINE_VERIFY_TOKEN_URL=https://api.line.me/oauth2/v2.1/verify
LINE_USER_PROFILE_URL=https://api.line.me/v2/profile

# CORS Configuration (optional)
CORS_ALLOWED_ORIGINS=https://ss.unayung.cc,http://localhost:3000,http://localhost:4000

# Production Deployment (production only)
DEPLOY_USER=apps
DEPLOY_HOST=ss.unayung.cc
DEPLOY_REPO=git@github.com:Unayung/SaiensCreditSystem.git
DEPLOY_PATH=/home/apps/saiensCreditSystem